# syntax=docker/dockerfile:1
FROM golang:1.25.5

RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libwebp-dev \
    libgif-dev \
    libtiff-dev \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libavfilter-dev \
    libmp3lame-dev \
    libopus-dev \
    libvorbis-dev \
    libvpx-dev \
    libx264-dev \
    libx265-dev \
    libopencv-dev \
    pkg-config \
    cmake \
    make \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY src/go.mod src/go.sum ./
RUN go mod download

COPY src/* ./

# CGO enabled required for lilliput
RUN CGO_ENABLED=1 GOOS=linux go build \
    -tags=av_bindings \
    -o server \
    .

EXPOSE 8080
CMD ["./server"]